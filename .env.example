# Generated by scripts/generate-environment.py; never put real credentials here.
# .env is loaded explicitly by Compose or --env-file, never implicitly by the library.
# Defaults < selected TOML < explicit dotenv < process environment < non-secret CLI.
SL_DATA_ROOT=data
# SL_DB_PATH=data/db/ledger.sqlite3
# SL_LEGACY_JOBS_PATH=data/jobs.sqlite3
SL_HOST=127.0.0.1
SL_PORT=8765
SL_LOG_LEVEL=INFO
SL_ENABLE_JEV=0
SL_JEV_MODEL=jev-1.13.0
SL_WORKER_CAPABILITY=cpu
SL_WORKER_POLL_SECONDS=0.5
SL_WORKER_LEASE_SECONDS=60
SL_WORKER_HEARTBEAT_SECONDS=10
SL_MAX_ARTIFACT_BYTES=2147483648
SL_SQLITE_JOURNAL_MODE=DELETE
SL_REMOTE_BUDGET_MICRO_USD=0
SL_REMOTE_ESTIMATE_MICRO_USD=0
SL_SPEECH_MODEL_NAME=whisper
SL_SPEECH_COMPUTE_TYPE=float16

# Control inputs (optional):
# SL_CONFIG_FILE=config/local.toml
# SL_ENV_FILE=.env
# SL_SECRET_DIR=/run/secrets
# Live-test opt-in: local agent only; leave unset in CI.
SL_RUN_LIVE=

# Empty credentials are valid while their operation is disabled.
SL_SECRET_API_TOKEN=
# Transitional aliases (conflicting values fail): SL_API_TOKEN
SL_SECRET_TYPESAFE_API_KEY=
# Transitional aliases (conflicting values fail): TYPESAFE_API_KEY
SL_SECRET_YOUTUBE_API_KEY=
# Transitional aliases (conflicting values fail): YOUTUBE_API_KEY
SL_SECRET_FACTCHECK_API_KEY=
# Transitional aliases (conflicting values fail): FACTCHECK_API_KEY
SL_SECRET_HF_TOKEN=
# Transitional aliases (conflicting values fail): HF_TOKEN
