# Inventory of every setting and secret, by name only. Copy to .env (gitignored) and fill
# in locally. Never commit .env or put secret values in tickets, PRs or chat prompts.

# Generate a new token; no sample token is intentionally supplied.
SL_API_TOKEN=
SL_DB_PATH=data/ledger.sqlite3
# Optional explicit discovery inputs, never required to run the local demo:
YOUTUBE_API_KEY=
FACTCHECK_API_KEY=
# Optional local diarization model access; separate worker environment recommended:
HF_TOKEN=

# Jev is optional and OFF by default. Only the official TypeSafe endpoint is used.
SL_ENABLE_JEV=0
TYPESAFE_API_KEY=
SL_JEV_MODEL=jev-1.13.0
# All referenced source grants must permit send_to_provider before a call is sent.
# Speaker pattern learning needs learn_profile; acoustic comparisons need process_biometrics.

# Live tests (@pytest.mark.live) need real secrets, providers, GPU or media; opt in locally.
SL_RUN_LIVE=0
