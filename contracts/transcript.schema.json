{
  "$defs": {
    "Segment": {
      "additionalProperties": false,
      "properties": {
        "end_ms": {
          "minimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "overlap": {
          "default": false,
          "title": "Overlap",
          "type": "boolean"
        },
        "speaker_label": {
          "maxLength": 180,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Speaker Label",
          "type": "string"
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        },
        "text": {
          "maxLength": 100000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "start_ms",
        "end_ms",
        "speaker_label",
        "text"
      ],
      "title": "Segment",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "asset_id": {
      "maxLength": 180,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:-]+$",
      "title": "Asset Id",
      "type": "string"
    },
    "engine": {
      "maxLength": 100000,
      "minLength": 1,
      "title": "Engine",
      "type": "string"
    },
    "id": {
      "maxLength": 180,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:-]+$",
      "title": "Id",
      "type": "string"
    },
    "input_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input Sha256"
    },
    "language": {
      "default": "en",
      "title": "Language",
      "type": "string"
    },
    "model_revision": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Revision"
    },
    "precision": {
      "default": "segment",
      "enum": [
        "segment",
        "word",
        "manual"
      ],
      "title": "Precision",
      "type": "string"
    },
    "segments": {
      "items": {
        "$ref": "#/$defs/Segment"
      },
      "maxItems": 100000,
      "minItems": 1,
      "title": "Segments",
      "type": "array"
    }
  },
  "required": [
    "asset_id",
    "engine",
    "segments"
  ],
  "title": "Transcript",
  "type": "object"
}
