{
  "additionalProperties": false,
  "properties": {
    "evidence": {
      "items": {
        "type": "string"
      },
      "title": "Evidence",
      "type": "array"
    },
    "id": {
      "maxLength": 180,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:-]+$",
      "title": "Id",
      "type": "string"
    },
    "person_id": {
      "maxLength": 180,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:-]+$",
      "title": "Person Id",
      "type": "string"
    },
    "reviewer": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewer"
    },
    "speaker_label": {
      "maxLength": 180,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:-]+$",
      "title": "Speaker Label",
      "type": "string"
    },
    "status": {
      "default": "candidate",
      "enum": [
        "candidate",
        "confirmed",
        "rejected"
      ],
      "title": "Status",
      "type": "string"
    },
    "transcript_id": {
      "maxLength": 180,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:-]+$",
      "title": "Transcript Id",
      "type": "string"
    }
  },
  "required": [
    "transcript_id",
    "speaker_label",
    "person_id"
  ],
  "title": "SpeakerMapping",
  "type": "object"
}
