{
  "additionalProperties": false,
  "properties": {
    "id": {
      "maxLength": 180,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:-]+$",
      "title": "Id",
      "type": "string"
    },
    "observation_id": {
      "maxLength": 180,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:-]+$",
      "title": "Observation Id",
      "type": "string"
    },
    "resolution": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resolution"
    },
    "resolved_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resolved At"
    },
    "reviewer": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewer"
    },
    "status": {
      "default": "reported",
      "enum": [
        "reported",
        "verified",
        "resolved"
      ],
      "title": "Status",
      "type": "string"
    },
    "target_id": {
      "maxLength": 180,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:-]+$",
      "title": "Target Id",
      "type": "string"
    },
    "target_kind": {
      "title": "Target Kind",
      "type": "string"
    },
    "text": {
      "maxLength": 100000,
      "minLength": 1,
      "title": "Text",
      "type": "string"
    }
  },
  "required": [
    "target_kind",
    "target_id",
    "observation_id",
    "text"
  ],
  "title": "Correction",
  "type": "object"
}
