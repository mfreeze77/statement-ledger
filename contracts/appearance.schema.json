{
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "maxLength": 180,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:-]+$",
      "title": "Event Id",
      "type": "string"
    },
    "id": {
      "maxLength": 180,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:-]+$",
      "title": "Id",
      "type": "string"
    },
    "observation_ids": {
      "items": {
        "maxLength": 180,
        "minLength": 1,
        "pattern": "^[a-zA-Z0-9_.:-]+$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Observation Ids",
      "type": "array"
    },
    "person_id": {
      "maxLength": 180,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:-]+$",
      "title": "Person Id",
      "type": "string"
    },
    "rationale": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rationale"
    },
    "reviewer": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewer"
    },
    "status": {
      "default": "candidate",
      "enum": [
        "candidate",
        "confirmed",
        "mentioned_only",
        "rejected"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "person_id",
    "observation_ids"
  ],
  "title": "Appearance",
  "type": "object"
}
